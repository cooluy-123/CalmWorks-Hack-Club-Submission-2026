-- Server-only structural validation. Model output is data, never executable code.
local HttpService = game:GetService("HttpService")
local Text = require(game.ReplicatedStorage.CalmWorksShared:WaitForChild("ScenarioText"))
local Validator = {}

local function copy(value)
    if type(value) ~= "table" then
        return value
    end
    local result = {}
    for key, item in pairs(value) do
        result[key] = copy(item)
    end
    return result
end

local function exactKeys(value, allowed)
    if type(value) ~= "table" then
        return false
    end
    for key in pairs(value) do
        if not allowed[key] then
            return false
        end
    end
    return true
end

local function array(value, count)
    if type(value) ~= "table" or #value ~= count then
        return false
    end
    for key in pairs(value) do
        if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > count then
            return false
        end
    end
    return true
end

local function normalized(value)
    return string.lower(value):gsub("%p", ""):gsub("%s+", " ")
end

local excludedThemes = {
    "suicide",
    "self-harm",
    "self harm",
    "sexual",
    "nude",
    "rape",
    "murder",
    "gun",
    "knife",
    "bomb",
    "weapon",
}
local function text(value, minimum, maximum)
    if type(value) ~= "string" or #value > maximum * 4 then
        return false
    end
    local size = utf8.len(value)
    if not size or size < minimum or size > maximum or not value:find("%S") then
        return false
    end
    if value:find("[%z\1-\8\11\12\14-\31]") or value:find("[<>]") or value:find("###", 1, true) then
        return false
    end
    local lower = string.lower(value)
    if lower:find("https?://") or lower:find("www%.") or lower:find("[%w._%%+-]+@[%w.-]+%.[%a]+") then
        return false
    end
    for _, word in ipairs(excludedThemes) do
        local escaped = word:gsub("(%W)", "%%%1")
        if lower:find("%f[%a]" .. escaped .. "%f[%A]") then
            return false
        end
    end
    return true
end

local function decode(raw)
    if type(raw) ~= "string" or #raw > 24000 then
        return nil, "json_size_or_type"
    end
    -- Roblox adds this fixed disclosure before JSON. The same disclosure remains
    -- visible in the editable gameplay UI; do not accept arbitrary surrounding prose.
    local disclosure = "Content generated by artificial intelligence, may make mistakes."
    raw = raw:match("^%s*(.-)%s*$") or raw
    if raw:sub(1, #disclosure) == disclosure then
        raw = raw:sub(#disclosure + 1):match("^%s*(.-)%s*$")
    end
    -- Accept one complete JSON fence, never a fragment inside surrounding prose.
    if raw:sub(1, 3) == "```" then
        local fenced = raw:match("^```json%s*\n(.-)\n%s*```$") or raw:match("^```%s*\n(.-)\n%s*```$")
        if not fenced then
            return nil, "json_wrapper"
        end
        raw = fenced:match("^%s*(.-)%s*$")
    end
    local ok, value = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok then
        return nil, "json_invalid_or_truncated"
    end
    if type(value) ~= "table" or raw:sub(1, 1) ~= "{" then
        return nil, "json_root"
    end
    return value
end

function Validator.DecodeCandidate(raw, source, config)
    local data, reason = decode(raw)
    if not data then
        return nil, reason
    end
    if not exactKeys(data, { Title = true, Feedback = true, Stages = true }) then
        return nil, "schema_fields"
    end
    if not text(data.Title, 4, 80) or not text(data.Feedback, 20, 320) then
        return nil, "text_bounds"
    end
    if not array(data.Stages, #source.Stages) then
        return nil, "stage_count"
    end
    local candidate = copy(source)
    candidate.Title, candidate.Feedback = data.Title, data.Feedback
    local changed = false
    for index, stage in ipairs(data.Stages) do
        if
            not exactKeys(
                stage,
                { Background = true, CustomerInsight = true, Choices = true, ChoiceFeedback = true }
            )
        then
            return nil, "stage_schema"
        end
        -- Assembly order is server-owned; the model cannot put its insight first.
        if not text(stage.Background, 35, 420) or type(stage.CustomerInsight) ~= "string" then
            return nil, "presentation_fields"
        end
        if stage.CustomerInsight ~= "" and not text(stage.CustomerInsight, 3, 220) then
            return nil, "presentation_fields"
        end
        if source.CustomerProfile and Text.OneParagraph(stage.CustomerInsight) == "" then
            return nil, "missing_customer_insight"
        end
        if source.WorkplaceContext and not string.lower(stage.Background):find("calmworks", 1, true) then
            return nil, "workplace_context_missing"
        end
        local background = Text.OneParagraph(stage.Background)
        local insight = Text.OneParagraph(stage.CustomerInsight)
        local lower = string.lower(background)
        for _, opening in ipairs({
            "you ",
            "your ",
            "you're ",
            "at your ",
            "after you ",
            "when you ",
            "while you ",
            "as a player",
            "the player ",
        }) do
            if lower:sub(1, #opening) == opening then
                return nil, "player_directed_background"
            end
        end
        local prompt = Text.Compose(background, insight)
        if
            not text(prompt, 35, math.min(config.CustomerPromptMaxCharacters or 420, 420))
            or not array(stage.Choices, 3)
            or not array(stage.ChoiceFeedback, 3)
        then
            return nil, "stage_bounds"
        end
        local seen, shortest, longest = {}, math.huge, 0
        for choice = 1, 3 do
            if
                not text(stage.Choices[choice], 25, 210) or not text(stage.ChoiceFeedback[choice], 15, 260)
            then
                return nil, "choice_bounds"
            end
            local key = normalized(stage.Choices[choice])
            if seen[key] then
                return nil, "duplicate_choice"
            end
            seen[key] = true
            local words = 0
            for _ in stage.Choices[choice]:gmatch("%S+") do
                words += 1
            end
            if words < 7 or words > 35 then
                return nil, "choice_length"
            end
            shortest, longest = math.min(shortest, words), math.max(longest, words)
        end
        if longest / shortest > (config.AIScenarioChoiceLengthRatio or 1.65) then
            return nil, "unequal_choices"
        end
        if
            normalized(background)
            ~= normalized(
                Text.OneParagraph(
                    source.Stages[index].Background
                        or source.Stages[index].BasePrompt
                        or source.Stages[index].Prompt
                )
            )
        then
            changed = true
        end
        candidate.Stages[index].BasePrompt = background
        candidate.Stages[index].Background = background
        candidate.Stages[index].CustomerInsight = insight
        candidate.Stages[index].Prompt = prompt
        candidate.Stages[index].Choices = copy(stage.Choices)
        candidate.Stages[index].ChoiceFeedback = copy(stage.ChoiceFeedback)
    end
    if not changed then
        return nil, "unchanged_scenario"
    end
    -- Metadata, best indexes, scores, stage count and FRQ rubric come only from the server.
    candidate.TemplateId = source.TemplateId or source.Id
    candidate.Id = candidate.TemplateId .. ":AI:" .. HttpService:GenerateGUID(false)
    candidate.SourceKind = "AI"
    candidate.PresentationVersion = "BackgroundFirstV1"
    candidate.PerspectiveVersion = "CustomerVoiceV1"
    return candidate
end

local function answersMatch(review, candidate)
    if review.BestKeys ~= nil then
        if not array(review.BestKeys, #candidate.Stages) then
            return false
        end
        for i, stage in ipairs(candidate.Stages) do
            if review.BestKeys[i] ~= string.char(64 + stage.BestIndex) then
                return false
            end
        end
        if review.BestChoices == nil and review.BestIndices == nil then
            return true
        end
    end
    if review.BestChoices ~= nil then
        if not array(review.BestChoices, #candidate.Stages) then
            return false
        end
        for i, stage in ipairs(candidate.Stages) do
            if review.BestChoices[i] ~= stage.Choices[stage.BestIndex] then
                return false
            end
        end
        if review.BestIndices == nil then
            return true
        end
    end
    -- Older fixtures may return indices. Never guess or shift a zero-based key.
    if not array(review.BestIndices, #candidate.Stages) then
        return false
    end
    for i, stage in ipairs(candidate.Stages) do
        if review.BestIndices[i] ~= stage.BestIndex then
            return false
        end
    end
    return true
end

function Validator.ValidateReview(raw, candidate)
    local review = decode(raw)
    if type(review) ~= "table" then
        return false, "review_json"
    end
    if candidate.PerspectiveVersion == "CustomerVoiceV1" and review.CustomerVoice ~= true then
        return false, "review_CustomerVoice"
    end
    if candidate.WorkplaceContext and review.WorkplaceAligned ~= true then
        return false, "review_WorkplaceAligned"
    end
    if candidate.CustomerProfile and review.CustomerAligned ~= true then
        return false, "review_CustomerAligned"
    end
    if candidate.PresentationVersion == "BackgroundFirstV1" and review.BackgroundFirst ~= true then
        return false, "review_BackgroundFirst"
    end
    for _, key in ipairs({
        "Safe",
        "Grounded",
        "UniqueBest",
        "PlausibleChoices",
        "DifficultyAligned",
        "CoherentStages",
        "FeedbackAccurate",
        "TargetSkillAligned",
        "ChoiceRolesPreserved",
        "NoPersonalData",
    }) do
        if review[key] ~= true then
            return false, "review_" .. key
        end
    end
    if not answersMatch(review, candidate) then
        return false, "answer_key_disagreement"
    end
    return true
end

function Validator.VisibleText(candidate)
    local strings = { candidate.Title, candidate.Feedback }
    for _, stage in ipairs(candidate.Stages) do
        table.insert(strings, stage.Prompt)
        for _, value in ipairs(stage.Choices) do
            table.insert(strings, value)
        end
        for _, value in ipairs(stage.ChoiceFeedback) do
            table.insert(strings, value)
        end
    end
    return table.concat(strings, "\n")
end

function Validator.ValidateBlindCheck(raw, candidate)
    local check = decode(raw)
    if type(check) ~= "table" or check.Safe ~= true or check.UniqueBest ~= true then
        return false, "blind_review_rejected"
    end
    if not answersMatch(check, candidate) then
        return false, "blind_answer_disagreement"
    end
    return true
end

return Validator
